# Local PostgreSQL: docker compose up -d db (run from the repository root).
# Replace these local credentials for any shared or public deployment.
DATABASE_URL=postgresql://expensely:expensely-local@localhost:5433/expensely

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_DAYS=30

# Optional Gmail import. Keep credential and token files out of git.
GMAIL_WEB_CREDENTIALS_FILE=credentials.web.json
GMAIL_REDIRECT_URI=http://localhost:8001/api/gmail/callback
GMAIL_QUERY=newer_than:14d
MAIL_SYNC_MAX_RESULTS=50
MAIL_SYNC_PROCESS_MAX_RESULTS=10

# Optional AI extraction for bank-email formats without a local parser.
# NVIDIA_API_KEY=nvapi-...
